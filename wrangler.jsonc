{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One codebase, deployed as two Workers on two hostnames:
  //   npx wrangler deploy --env gallery   pages, API and admin
  //   npx wrangler deploy --env sandbox   shows builds inside a frame, nothing else
  // The top level is local development only (npm run dev).
  "name": "agent-playground-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "build": { "command": "node scripts/embed-static.mjs", "watch_dir": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-playground",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GALLERY_ORIGIN": "http://localhost:8787",
    "SANDBOX_ORIGIN": "http://127.0.0.1:8787"
  },
  // Production. Both Workers share the database and must agree on the two
  // origins. Their secrets (ADMIN_TOKEN, SIGNING_SECRET) are stored on
  // Cloudflare and are kept across deploys.
  "env": {
    "gallery": {
      "name": "agent-playground",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      "triggers": { "crons": ["17 9 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-playground",
          "database_id": "acebd25d-68d6-4295-aa01-de2699ee76a2",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "GALLERY_ORIGIN": "https://agent-playground.sleepvista.workers.dev",
        "SANDBOX_ORIGIN": "https://agent-playground-sandbox.sleepvista.workers.dev"
      }
    },
    "sandbox": {
      "name": "agent-playground-sandbox",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-playground",
          "database_id": "acebd25d-68d6-4295-aa01-de2699ee76a2",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "GALLERY_ORIGIN": "https://agent-playground.sleepvista.workers.dev",
        "SANDBOX_ORIGIN": "https://agent-playground-sandbox.sleepvista.workers.dev"
      }
    }
  }
}
