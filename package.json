{
  "name": "agent-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "wrangler types && node scripts/embed-static.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node test/browser/containment.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check": "npm run typecheck && npm test",
    "deploy:gallery": "wrangler d1 migrations apply DB --env gallery --remote && wrangler deploy --env gallery",
    "deploy:sandbox": "wrangler deploy --env sandbox"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
